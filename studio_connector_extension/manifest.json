{
  "manifest_version": 3,
  "name": "TE YouTube Studio Connector (prototype)",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Read visible YouTube Studio channel identities on request. No uploading.",
  "permissions": ["activeTab", "nativeMessaging", "sidePanel", "storage"],
  "host_permissions": ["https://studio.youtube.com/*"],
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_scripts": [{
    "matches": ["https://studio.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {"default_title": "Mở TE Studio Connector"}
}
