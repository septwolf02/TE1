{
  "manifest_version": 3,
  "name": "TE YouTube Studio Connector (prototype)",
  "version": "0.3.0",
  "minimum_chrome_version": "118",
  "description": "Read Studio channel identities and hand a verified private-test MP4 to Studio.",
  "permissions": ["activeTab", "nativeMessaging", "sidePanel", "storage", "debugger", "tabs", "alarms"],
  "host_permissions": ["https://studio.youtube.com/*"],
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_scripts": [{
    "matches": ["https://studio.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {"default_title": "Mở TE Studio Connector"}
}
